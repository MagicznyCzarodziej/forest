{
  "name": "forest",
  "version": "0.1.0",
  "description": "CLI for managing repos and git worktrees",
  "type": "module",
  "bin": {
    "forest": "./dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite-node src/index.ts",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "npm run lint && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fuzzysort": "^4.0.2",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
